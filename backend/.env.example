# Google Gemini API Key (Optional but recommended for full AI live reasoning)
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_api_key_here

# USDA FoodData Central key (optional; DEMO_KEY is used by default)
# For higher request limits, create a key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=DEMO_KEY

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
